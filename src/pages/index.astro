<!doctype html>
<html lang="nl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Intro tot vibe coding voor leerkrachten</title><meta name="description" content="Van een behoefte in je les naar een kleine, bruikbare toepassing. Workshop en kopieerbare prompts voor leerkrachten."/><script is:inline>document.documentElement.classList.add('js');</script></head>
<body><a class="skip" href="#inhoud">Ga naar inhoud</a>
<header><a href="#start"><img src={logo.src} height="28" alt="Arcadia scholen"/><strong>Vibe coding voor leerkrachten</strong></a><span>Workshop en naslagwerk</span></header>
<div class="shell"><aside><details open><summary>Leerpad · navigatie</summary><nav aria-label="Leerpad">{groups.map(g=><div class="group"><p class="eyebrow">{g.title}</p><ul>{g.items.map(p=><li><a href={`#${p.id}`} data-nav={p.id}>{p.label}</a></li>)}</ul></div>)}</nav></details></aside>
<main id="inhoud" tabindex="-1">
<nav class="cycle" aria-label="De vijf stappen">{cycle.map((p,i)=><><a href={`#${p.id}`} data-cycle={p.id}>{p.label}</a>{i<4&&<span aria-hidden="true">→</span>}</>)}</nav>
{pages.map(p=><section data-page={p.id} data-cycle-page={p.cycle} id={p.id} aria-labelledby={`title-${p.id}`}>
{p.id==='start'&&<svg class="opening-illustration" viewBox="0 0 600 400" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"><rect x="105" y="55" width="390" height="255" rx="18"/><path d="M105 100h390M65 310h470l35 42H30zM235 352h130"/><path d="m215 155-45 35 45 35m170-70 45 35-45 35m-65-90-35 110M165 267h90m35 0h45"/><circle cx="130" cy="78" r="3"/><circle cx="149" cy="78" r="3"/></g></svg>}
{p.id==='privacy'&&<svg class="privacy-illustration" viewBox="0 0 440 440" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"><path d="M220 35c45 33 93 48 145 55v120c0 90-57 152-145 195C132 362 75 300 75 210V90c52-7 100-22 145-55Z"/><rect x="153" y="192" width="134" height="112" rx="18"/><path d="M177 192v-35a43 43 0 0 1 86 0v35"/><circle cx="220" cy="238" r="10"/><path d="M220 248v22"/></g></svg>}
{p.id==='aan-de-slag'&&<svg class="conversation-illustration" viewBox="0 0 460 390" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"><path d="M65 45h255a25 25 0 0 1 25 25v125a25 25 0 0 1-25 25H155l-65 50v-50H65a25 25 0 0 1-25-25V70a25 25 0 0 1 25-25Z"/><path d="M190 245v25a25 25 0 0 0 25 25h95l60 48v-48h25a25 25 0 0 0 25-25V160a25 25 0 0 0-25-25h-22M95 105h190M95 145h140M245 255h100"/></g></svg>}
<p class="eyebrow">{p.group}{p.cycle?': '+p.label:''}</p><h1 id={`title-${p.id}`}>{p.title}</h1>{p.lead&&<p class="lead">{p.lead}</p>}
<div class="page-body" set:html={p.body}/>
{p.tip&&<div class="tip"><span aria-hidden="true">💡</span><p><strong>Tip:</strong> {p.tip}</p></div>}
{p.id==='bouwen'&&<div class="solution-part"><h2>1. Laat je toepassing bouwen</h2></div>}
{p.id==='oplossing'&&<div class="solution-part"><h2>1. Verken en vergelijk</h2><p>Laat AI enkele oplossingen voorstellen. Vergelijk hoe ze je behoefte aanpakken en kies één kleine kernfunctie.</p></div>}
{p.prompt&&<div class="prompt-with-cheat"><details class="prompt-details" open><summary>Prompt bekijken en kopiëren</summary><p class="small">Vul de stukken tussen [haakjes] aan.</p><Prompt>{p.prompt.split('\n\n').map(text=><p>{text}</p>)}</Prompt></details><details class="cheat-sheet"><summary><span aria-hidden="true">📝</span> Spiekbriefje</summary><div class="cheat-body"><strong>In je eigen woorden? Vermeld zeker:</strong><ul>{(cheatSheets[p.id]??[]).map(point=><li>{point}</li>)}</ul></div></details></div>}
{p.id==='oplossing'&&<div class="solution-part solution-choice"><h2>2. Leg je keuze vast</h2><p>Benoem welke oplossing je kiest en laat AI die kort samenvatten. Controleer of het bouwidee aansluit bij jouw behoefte.</p><div class="prompt-with-cheat"><details class="prompt-details" open><summary>Prompt bekijken en kopiëren</summary><p class="small">Vul het voorstel in dat je gekozen hebt.</p><Prompt><p>Werk voorstel [nummer/omschrijving] uit tot een klein bouwidee. Vat samen voor wie de toepassing is, wat de gebruiker ermee kan en hoe dat mijn behoefte helpt.</p><p>Benoem de kernfunctie van de eerste versie en wat we voorlopig weglaten. Schrijf nog geen code.</p></Prompt></details><details class="cheat-sheet"><summary><span aria-hidden="true">📝</span> Spiekbriefje</summary><div class="cheat-body"><strong>In je eigen woorden? Vermeld zeker:</strong><ul><li>Benoem welk voorstel je kiest.</li><li>Laat doelgroep, werking en meerwaarde kort samenvatten.</li><li>Leg de kernfunctie en de grenzen van de eerste versie vast. Nog geen code.</li></ul></div></details></div></div>}
{p.id==='testen'&&<div class="testing-stage"><h2>3. Laat een collega of leerling testen</h2><p>Laat iemand je toepassing gebruiken en kijk waar die vastloopt of twijfelt. Vraag de tester hardop te zeggen wat die denkt.</p><div class="tip"><span aria-hidden="true">💡</span><p><strong>Tip:</strong> Doe dit pas na enkele iteraties, wanneer je toepassing al behoorlijk werkt. Gebruik de feedback om opnieuw gericht te verbeteren en te testen.</p></div></div>}
{p.id==='bouwen'&&<div class="tip"><span aria-hidden="true">💡</span><p><strong>Aan het wachten terwijl AI bouwt?</strong> Bedenk alvast enkele testscenario’s en noteer ze in een kort document: <strong>‘Als ik … doe, dan verwacht ik …’</strong> Bijvoorbeeld: ‘Als ik een antwoord leeg laat en op controleren klik, dan verwacht ik een melding om iets in te vullen.’ Denk aan normaal gebruik én aan fouten of onverwachte handelingen. Zo weet je straks precies wat je gaat testen.</p></div>}
{p.id==='bouwen'&&<div class="solution-part solution-choice"><h2>2. Open je eerste versie</h2><ol class="route-list"><li>Download het HTML-bestand uit je AI-gesprek.</li><li>Open het vanuit je downloadmap in Edge, Chrome of een andere browser.</li><li>Probeer de toepassing uit. Controleer ook het bestand zelf, niet alleen de voorbeeldweergave in de chatbot.</li></ol><details class="code-help"><summary>Ik krijg alleen code of mijn bestand opent niet</summary><p>Bewaar de code als platte tekst. De bestandsnaam moet eindigen op .html, niet op .html.txt. Gebruik geen Word-document.</p><div class="prompt-with-cheat"><details class="prompt-details" open><summary>Hulpprompt bekijken en kopiëren</summary><Prompt><p>Ik heb alleen code gekregen. Leg me stap voor stap uit hoe ik die op [Windows/Mac] met een gewone teksteditor bewaar als index.html en open in mijn browser. Geef instructies zonder extra programma’s te installeren.</p></Prompt></details><details class="cheat-sheet"><summary><span aria-hidden="true">📝</span> Spiekbriefje</summary><div class="cheat-body"><strong>In je eigen woorden? Vermeld zeker:</strong><ul>{cheatSheets.openen.map(point=><li>{point}</li>)}</ul></div></details></div></details></div>}
{p.id==='itereren'&&<div class="solution-part solution-choice"><h2>Lay-out en huisstijl verfijnen</h2><p>Zorg voor een rustige indeling, leesbare tekst, voldoende contrast en duidelijke knoppen. Gebruik naast kleur ook tekst of iconen.</p><p>Geef AI het echte logo, de kleurcodes en de relevante richtlijnen mee uit de <a href="https://www.arcadiascholen.be/brands" target="_blank" rel="noopener noreferrer">huisstijlgids van Arcadia ↗</a>.</p><div class="prompt-with-cheat"><details class="prompt-details" open><summary>Prompt bekijken en kopiëren</summary><Prompt><p>Pas nu alleen de vormgeving aan aan de bijgevoegde huisstijl van [school/scholengroep].</p><p>Zorg voor een rustige indeling, goed leesbare tekst, voldoende contrast en duidelijke knoppen. Gebruik de huisstijlkleuren en het echte logo waar ze de leesbaarheid ondersteunen.</p><p>Behoud alle inhoud en werking. Geef het volledige aangepaste HTML-bestand terug.</p></Prompt></details><details class="cheat-sheet"><summary><span aria-hidden="true">📝</span> Spiekbriefje</summary><div class="cheat-body"><strong>In je eigen woorden? Vermeld zeker:</strong><ul>{cheatSheets.vormgeving.map(point=><li>{point}</li>)}</ul></div></details></div><div class="tip"><span aria-hidden="true">💡</span><p><strong>Tip:</strong> Alleen een link delen garandeert niet dat AI de huisstijl kan lezen. Voeg de nodige richtlijnen en logobestanden toe. Test na de aanpassing opnieuw de werking.</p></div></div>}
{p.id==='behoefte'&&<div class="tip"><span aria-hidden="true">💡</span><p><strong>Spreek je prompt gerust in.</strong> Zeker thuis kan vertellen makkelijker zijn dan typen. Spreek zoals je het aan een collega zou uitleggen en controleer de tekst vóór je verstuurt.</p></div>}

</section>)}
<footer class="pagination"><a data-prev href="#start">← Vorige</a><span data-position aria-live="polite"></span><a data-next href="#definitie">Volgende →</a></footer>
</main></div>
<script>
const pages=Array.from(document.querySelectorAll<HTMLElement>('[data-page]'));
const ids=pages.map(p=>p.id);
const cycleIds=['behoefte','oplossing','bouwen','testen','itereren'];
function render(){
 const aliases: Record<string,string>={'waarom-leren':'waarom',klein:'vandaag',openen:'bouwen',vormgeving:'itereren',alternatieven:'publiceren',netlify:'publiceren',bijwerken:'publiceren'}; const hash=aliases[location.hash.slice(1)]||location.hash.slice(1); const id=ids.includes(hash)?hash:'start'; const i=ids.indexOf(id);
 pages.forEach(p=>{p.hidden=p.id!==id});
 document.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach(a=>{if(a.dataset.nav===id)a.setAttribute('aria-current','page');else a.removeAttribute('aria-current')});
 document.querySelectorAll<HTMLAnchorElement>('[data-cycle]').forEach(a=>{if(a.dataset.cycle===(pages.find(p=>p.id===id)?.dataset.cyclePage||id))a.setAttribute('aria-current','step');else a.removeAttribute('aria-current')});
 const cycle=document.querySelector<HTMLElement>('.cycle');if(cycle)cycle.hidden=!cycleIds.includes(pages.find(p=>p.id===id)?.dataset.cyclePage||id);
 const prev=document.querySelector<HTMLAnchorElement>('[data-prev]');const next=document.querySelector<HTMLAnchorElement>('[data-next]');
 if(prev){prev.hidden=i===0;prev.href='#'+ids[Math.max(0,i-1)]}if(next){next.hidden=i===ids.length-1;next.href='#'+ids[Math.min(ids.length-1,i+1)]}
 const pos=document.querySelector('[data-position]');if(pos)pos.textContent=`${i+1} / ${ids.length}`;
 document.title=(document.querySelector(`[data-nav="${id}"]`)?.textContent??'Intro tot vibe coding')+' | AI voor leerkrachten';
 try{localStorage.setItem('vibecoding-voor-leerkrachten:last-step',id)}catch{}
 window.scrollTo(0,0);
}
if(!location.hash){try{const last=localStorage.getItem('vibecoding-voor-leerkrachten:last-step');if(last&&ids.includes(last))history.replaceState(null,'','#'+last)}catch{}}

document.querySelectorAll<HTMLButtonElement>('[data-process]').forEach(button=>button.addEventListener('click',()=>{
 document.querySelectorAll<HTMLButtonElement>('[data-process]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
 document.querySelectorAll<HTMLElement>('[data-process-detail]').forEach(panel=>panel.hidden=panel.dataset.processDetail!==button.dataset.process);
}));
render();window.addEventListener('hashchange',()=>{render();document.querySelector<HTMLElement>('[data-page]:not([hidden]) h1')?.setAttribute('tabindex','-1');document.querySelector<HTMLElement>('[data-page]:not([hidden]) h1')?.focus({preventScroll:true})});
document.addEventListener('keydown',e=>{if(e.target instanceof Element&&e.target.closest('input,textarea,select,button,summary,a,[contenteditable]'))return;if(e.altKey||e.ctrlKey||e.metaKey||e.shiftKey)return;const a=document.querySelector<HTMLAnchorElement>(e.key==='ArrowRight'?'[data-next]':e.key==='ArrowLeft'?'[data-prev]':'[data-none]');if(a&&!a.hidden){e.preventDefault();a.click()}});
</script>
</body></html>
